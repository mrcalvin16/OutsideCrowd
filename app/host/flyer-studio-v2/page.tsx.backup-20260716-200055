"use client";

import { useMemo, useRef, useState } from "react";
import Link from "next/link";
import { useQuery } from "convex/react";
import { useAuth } from "@clerk/nextjs";
import { api } from "@/convex/_generated/api";
import { toPng } from "html-to-image";

type SidebarTool =
  | "templates"
  | "uploads"
  | "ai"
  | "text"
  | "brand"
  | "elements"
  | "background";

const sidebarTools: {
  id: SidebarTool;
  label: string;
  icon: string;
}[] = [
  { id: "templates", label: "Templates", icon: "▦" },
  { id: "uploads", label: "Uploads", icon: "↑" },
  { id: "ai", label: "AI Images", icon: "✦" },
  { id: "text", label: "Text", icon: "T" },
  { id: "brand", label: "Brand Kit", icon: "◆" },
  { id: "elements", label: "Elements", icon: "○" },
  { id: "background", label: "Background", icon: "▨" },
];

const templates = [
  {
    name: "Luxury Nightlife",
    style: "Luxury",
    prompt:
      "Luxury nightlife party with a stylish crowd, velvet rope exclusivity, cinematic lighting and premium event branding",
  },
  {
    name: "Afrobeats Night",
    style: "Afrobeats",
    prompt:
      "Afrobeats party with premium cultural nightlife energy, dancing crowd, warm luxury lighting and modern editorial styling",
  },
  {
    name: "Rooftop Social",
    style: "Rooftop",
    prompt:
      "Luxury rooftop event with skyline views, champagne atmosphere, elegant guests and cinematic sunset lighting",
  },
  {
    name: "Festival Energy",
    style: "Festival",
    prompt:
      "Large outdoor music festival with stage lights, crowd energy, confetti and premium campaign design",
  },
];

const formats = [
  { id: "poster", label: "Poster", ratio: "aspect-[2/3]" },
  { id: "square", label: "Square", ratio: "aspect-square" },
  { id: "story", label: "Story", ratio: "aspect-[9/16]" },
];

const styleOptions = [
  "Luxury",
  "Underground",
  "Festival",
  "Rooftop",
  "EDM",
  "Afrobeats",
  "College",
];

export default function FlyerStudioV2Page() {
  const { isLoaded, isSignedIn } = useAuth();

  const events = useQuery(
    api.events.getMyEvents,
    isLoaded && isSignedIn ? {} : "skip",
  ) as any[] | undefined;

  const canvasRef = useRef<HTMLDivElement | null>(null);

  const [activeTool, setActiveTool] = useState<SidebarTool>("templates");
  const [selectedEventId, setSelectedEventId] = useState("");
  const [prompt, setPrompt] = useState("");
  const [style, setStyle] = useState("Luxury");
  const [format, setFormat] = useState("poster");
  const [headline, setHeadline] = useState("Night Moves");
  const [subheadline, setSubheadline] = useState(
    "A premium event experience curated for the city.",
  );
  const [cta, setCta] = useState("Get Tickets");
  const [imagePreview, setImagePreview] = useState("");
  const [variations, setVariations] = useState<
    { id: string; imageUrl: string; caption?: string }[]
  >([]);
  const [isGenerating, setIsGenerating] = useState(false);
  const [status, setStatus] = useState("");
  const [textColor, setTextColor] = useState("#ffffff");
  const [overlayStrength, setOverlayStrength] = useState(55);
  const [titleSize, setTitleSize] = useState(58);
  const [zoom, setZoom] = useState(85);

  const selectedEvent = events?.find((event) => event._id === selectedEventId);

  const selectedFormat =
    formats.find((item) => item.id === format) || formats[0];

  const eventTitle = selectedEvent?.name || headline;

  const canvasScale = useMemo(() => zoom / 100, [zoom]);

  function applyTemplate(template: (typeof templates)[number]) {
    setPrompt(template.prompt);
    setStyle(template.style);
    setHeadline(template.name);
    setActiveTool("ai");
  }

  async function generateFlyer() {
    if (!prompt.trim()) {
      alert("Add a creative prompt first.");
      return;
    }

    try {
      setIsGenerating(true);
      setStatus("Generating your flyer...");

      const response = await fetch("/api/ai/generate-flyer", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          prompt,
          style,
          format,
          eventType: selectedEvent?.category || "nightlife",
          composition: "cinematic",
          quality: "premium",
          city: selectedEvent?.city || "New Orleans",
          eventTitle,
          venue: selectedEvent?.venue || "",
          cta,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success || !data.imageUrl) {
        throw new Error(data.error || "No image was returned.");
      }

      setImagePreview(data.imageUrl);
      setVariations(data.variations || []);
      setStatus("Flyer generated.");
    } catch (error) {
      console.error(error);
      setStatus("");
      alert(
        error instanceof Error
          ? error.message
          : "The flyer could not be generated.",
      );
    } finally {
      setIsGenerating(false);
      setTimeout(() => setStatus(""), 2500);
    }
  }

  async function downloadCanvas() {
    if (!canvasRef.current) return;

    const dataUrl = await toPng(canvasRef.current, {
      cacheBust: true,
      pixelRatio: 2,
      backgroundColor: "#000000",
    });

    const link = document.createElement("a");
    link.href = dataUrl;
    link.download = `${eventTitle || "outsidecrowd-flyer"}.png`;
    link.click();
  }

  return (
    <main className="min-h-screen bg-[#111111] text-white">
      <header className="flex min-h-16 items-center justify-between border-b border-white/10 bg-[#181818] px-4">
        <div className="flex items-center gap-4">
          <Link
            href="/host/flyer-studio"
            className="rounded-lg px-3 py-2 text-sm font-bold text-white/60 hover:bg-white/10 hover:text-white"
          >
            ← Back
          </Link>

          <div>
            <p className="text-sm font-black">OutsideCrowd Studio</p>
            <p className="text-xs text-white/35">Canva-style editor preview</p>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <button
            type="button"
            className="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-bold hover:bg-white/10"
          >
            Undo
          </button>

          <button
            type="button"
            className="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-bold hover:bg-white/10"
          >
            Redo
          </button>

          <button
            type="button"
            onClick={downloadCanvas}
            className="rounded-lg bg-violet-600 px-5 py-2 text-sm font-black hover:bg-violet-500"
          >
            Download
          </button>
        </div>
      </header>

      <div className="grid min-h-[calc(100vh-64px)] grid-cols-[76px_300px_minmax(0,1fr)_290px]">
        <aside className="border-r border-white/10 bg-[#171717] py-3">
          <div className="space-y-2 px-2">
            {sidebarTools.map((tool) => (
              <button
                key={tool.id}
                type="button"
                onClick={() => setActiveTool(tool.id)}
                className={`flex w-full flex-col items-center gap-1 rounded-xl px-1 py-3 text-[10px] font-bold transition ${
                  activeTool === tool.id
                    ? "bg-violet-600 text-white"
                    : "text-white/50 hover:bg-white/10 hover:text-white"
                }`}
              >
                <span className="text-xl">{tool.icon}</span>
                {tool.label}
              </button>
            ))}
          </div>
        </aside>

        <aside className="overflow-y-auto border-r border-white/10 bg-[#202020] p-4">
          {activeTool === "templates" && (
            <ToolPanel title="Templates">
              <div className="grid grid-cols-2 gap-3">
                {templates.map((template) => (
                  <button
                    key={template.name}
                    type="button"
                    onClick={() => applyTemplate(template)}
                    className="overflow-hidden rounded-xl border border-white/10 bg-black/30 text-left transition hover:border-violet-400/50"
                  >
                    <div className="aspect-[4/5] bg-gradient-to-br from-violet-700/50 via-black to-orange-500/30 p-3">
                      <p className="text-xs font-black">{template.name}</p>
                    </div>
                    <p className="p-2 text-[11px] font-bold text-white/60">
                      Use template
                    </p>
                  </button>
                ))}
              </div>
            </ToolPanel>
          )}

          {activeTool === "uploads" && (
            <ToolPanel title="Uploads">
              <label className="flex cursor-pointer flex-col items-center justify-center rounded-2xl border border-dashed border-white/20 bg-white/5 p-7 text-center hover:border-violet-400/50">
                <span className="text-2xl">↑</span>
                <span className="mt-2 text-sm font-black">Upload media</span>
                <span className="mt-1 text-xs text-white/40">
                  JPG, PNG or WebP
                </span>

                <input
                  type="file"
                  accept="image/*"
                  className="hidden"
                  onChange={(event) => {
                    const file = event.target.files?.[0];
                    if (!file) return;
                    setImagePreview(URL.createObjectURL(file));
                  }}
                />
              </label>
            </ToolPanel>
          )}

          {activeTool === "ai" && (
            <ToolPanel title="AI Image Generator">
              <label className="text-xs font-bold text-white/50">
                Select event
              </label>

              <select
                value={selectedEventId}
                onChange={(event) => {
                  const value = event.target.value;
                  setSelectedEventId(value);

                  const nextEvent = events?.find((item) => item._id === value);

                  if (nextEvent?.name) {
                    setHeadline(nextEvent.name);
                  }
                }}
                className="mt-2 w-full rounded-xl border border-white/10 bg-black/30 p-3 text-sm outline-none"
              >
                <option value="">No event selected</option>
                {(events || []).map((event) => (
                  <option key={event._id} value={event._id}>
                    {event.name || "Untitled Event"}
                  </option>
                ))}
              </select>

              <label className="mt-5 block text-xs font-bold text-white/50">
                Prompt
              </label>

              <textarea
                value={prompt}
                onChange={(event) => setPrompt(event.target.value)}
                placeholder="Describe the flyer background and atmosphere..."
                className="mt-2 min-h-36 w-full rounded-xl border border-white/10 bg-black/30 p-3 text-sm outline-none focus:border-violet-400"
              />

              <label className="mt-5 block text-xs font-bold text-white/50">
                Style
              </label>

              <div className="mt-2 flex flex-wrap gap-2">
                {styleOptions.map((option) => (
                  <button
                    key={option}
                    type="button"
                    onClick={() => setStyle(option)}
                    className={`rounded-full border px-3 py-2 text-xs font-bold ${
                      style === option
                        ? "border-violet-400 bg-violet-500/20"
                        : "border-white/10 bg-white/5 text-white/55"
                    }`}
                  >
                    {option}
                  </button>
                ))}
              </div>

              <button
                type="button"
                onClick={generateFlyer}
                disabled={isGenerating}
                className="mt-5 w-full rounded-xl bg-gradient-to-r from-violet-600 to-orange-500 px-4 py-3 text-sm font-black disabled:opacity-50"
              >
                {isGenerating ? "Generating..." : "Generate Image"}
              </button>

              {status && (
                <p className="mt-3 rounded-xl bg-violet-500/10 p-3 text-xs font-bold text-violet-200">
                  {status}
                </p>
              )}

              {variations.length > 1 && (
                <div className="mt-5 grid grid-cols-3 gap-2">
                  {variations.map((variation) => (
                    <button
                      key={variation.id}
                      type="button"
                      onClick={() => setImagePreview(variation.imageUrl)}
                      className="overflow-hidden rounded-lg border border-white/10"
                    >
                      <img
                        src={variation.imageUrl}
                        alt={variation.caption || "Flyer variation"}
                        className="aspect-[2/3] w-full object-cover"
                      />
                    </button>
                  ))}
                </div>
              )}
            </ToolPanel>
          )}

          {activeTool === "text" && (
            <ToolPanel title="Text">
              <button
                type="button"
                className="w-full rounded-xl border border-white/10 bg-white/5 p-4 text-left text-xl font-black"
              >
                Add a heading
              </button>

              <button
                type="button"
                className="mt-3 w-full rounded-xl border border-white/10 bg-white/5 p-4 text-left text-sm font-bold"
              >
                Add a subheading
              </button>

              <button
                type="button"
                className="mt-3 w-full rounded-xl border border-white/10 bg-white/5 p-4 text-left text-xs"
              >
                Add body text
              </button>
            </ToolPanel>
          )}

          {activeTool === "brand" && (
            <ToolPanel title="Brand Kit">
              <div className="rounded-xl border border-white/10 bg-black/30 p-4">
                <p className="text-sm font-black">OutsideCrowd</p>
                <p className="mt-1 text-xs text-white/40">
                  Black · Violet · Orange
                </p>

                <div className="mt-4 flex gap-2">
                  <div className="h-10 w-10 rounded-full bg-black ring-1 ring-white/20" />
                  <div className="h-10 w-10 rounded-full bg-violet-600" />
                  <div className="h-10 w-10 rounded-full bg-orange-500" />
                </div>
              </div>
            </ToolPanel>
          )}

          {activeTool === "elements" && (
            <ToolPanel title="Elements">
              <div className="grid grid-cols-3 gap-3">
                {["○", "□", "△", "✦", "◆", "↗", "★", "●", "＋"].map((shape) => (
                  <button
                    key={shape}
                    type="button"
                    className="aspect-square rounded-xl border border-white/10 bg-white/5 text-2xl hover:bg-white/10"
                  >
                    {shape}
                  </button>
                ))}
              </div>
            </ToolPanel>
          )}

          {activeTool === "background" && (
            <ToolPanel title="Background">
              <div className="grid grid-cols-3 gap-3">
                {[
                  "bg-black",
                  "bg-violet-950",
                  "bg-orange-950",
                  "bg-gradient-to-br from-violet-900 to-black",
                  "bg-gradient-to-br from-orange-800 to-black",
                  "bg-gradient-to-br from-violet-800 to-orange-700",
                ].map((background) => (
                  <button
                    key={background}
                    type="button"
                    className={`aspect-square rounded-xl border border-white/10 ${background}`}
                  />
                ))}
              </div>
            </ToolPanel>
          )}
        </aside>

        <section className="relative flex min-w-0 flex-col bg-[#151515]">
          <div className="flex items-center justify-between border-b border-white/10 bg-[#1c1c1c] px-4 py-3">
            <div className="flex items-center gap-2">
              {formats.map((item) => (
                <button
                  key={item.id}
                  type="button"
                  onClick={() => setFormat(item.id)}
                  className={`rounded-lg px-3 py-2 text-xs font-bold ${
                    format === item.id
                      ? "bg-white text-black"
                      : "bg-white/5 text-white/55"
                  }`}
                >
                  {item.label}
                </button>
              ))}
            </div>

            <div className="flex items-center gap-3">
              <button
                type="button"
                onClick={() => setZoom((value) => Math.max(40, value - 10))}
                className="rounded-lg bg-white/5 px-3 py-2"
              >
                −
              </button>
              <span className="w-12 text-center text-xs font-bold">
                {zoom}%
              </span>
              <button
                type="button"
                onClick={() => setZoom((value) => Math.min(130, value + 10))}
                className="rounded-lg bg-white/5 px-3 py-2"
              >
                +
              </button>
            </div>
          </div>

          <div className="flex flex-1 items-center justify-center overflow-auto p-10">
            <div
              style={{
                transform: `scale(${canvasScale})`,
                transformOrigin: "center",
              }}
              className="transition-transform"
            >
              <div
                ref={canvasRef}
                className={`relative w-[520px] overflow-hidden bg-black shadow-[0_30px_90px_rgba(0,0,0,0.65)] ${selectedFormat.ratio}`}
              >
                {imagePreview ? (
                  <img
                    src={imagePreview}
                    alt="Flyer artwork"
                    className="absolute inset-0 h-full w-full object-cover"
                  />
                ) : (
                  <div className="absolute inset-0 bg-gradient-to-br from-violet-900 via-black to-orange-800" />
                )}

                <div
                  className="absolute inset-0 bg-black"
                  style={{ opacity: overlayStrength / 100 }}
                />

                <div className="absolute inset-0 flex flex-col justify-between p-10">
                  <div>
                    <p
                      className="text-xs font-black uppercase tracking-[0.35em]"
                      style={{ color: textColor }}
                    >
                      OutsideCrowd Presents
                    </p>

                    <h1
                      className="mt-6 max-w-[430px] font-black uppercase leading-[0.86] tracking-[-0.06em]"
                      style={{
                        color: textColor,
                        fontSize: `${titleSize}px`,
                      }}
                    >
                      {eventTitle}
                    </h1>

                    <p
                      className="mt-6 max-w-sm text-base leading-relaxed opacity-80"
                      style={{ color: textColor }}
                    >
                      {subheadline}
                    </p>
                  </div>

                  <div>
                    <div className="mb-6 h-px bg-white/30" />

                    <div className="flex items-end justify-between gap-5">
                      <div>
                        <p
                          className="text-xs uppercase tracking-[0.25em] opacity-60"
                          style={{ color: textColor }}
                        >
                          {selectedEvent?.venue || "New Orleans"}
                        </p>

                        <p
                          className="mt-2 text-xl font-black"
                          style={{ color: textColor }}
                        >
                          {style}
                        </p>
                      </div>

                      <div className="rounded-full bg-white px-5 py-3 text-xs font-black text-black">
                        {cta}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <aside className="overflow-y-auto border-l border-white/10 bg-[#202020] p-5">
          <p className="text-xs font-black uppercase tracking-[0.25em] text-white/35">
            Design Controls
          </p>

          <ControlGroup label="Headline">
            <input
              value={headline}
              onChange={(event) => setHeadline(event.target.value)}
              className="w-full rounded-xl border border-white/10 bg-black/30 p-3 text-sm outline-none"
            />
          </ControlGroup>

          <ControlGroup label="Description">
            <textarea
              value={subheadline}
              onChange={(event) => setSubheadline(event.target.value)}
              className="min-h-24 w-full rounded-xl border border-white/10 bg-black/30 p-3 text-sm outline-none"
            />
          </ControlGroup>

          <ControlGroup label="Call to action">
            <input
              value={cta}
              onChange={(event) => setCta(event.target.value)}
              className="w-full rounded-xl border border-white/10 bg-black/30 p-3 text-sm outline-none"
            />
          </ControlGroup>

          <ControlGroup label={`Title size · ${titleSize}px`}>
            <input
              type="range"
              min="32"
              max="86"
              value={titleSize}
              onChange={(event) => setTitleSize(Number(event.target.value))}
              className="w-full"
            />
          </ControlGroup>

          <ControlGroup label={`Image overlay · ${overlayStrength}%`}>
            <input
              type="range"
              min="0"
              max="85"
              value={overlayStrength}
              onChange={(event) =>
                setOverlayStrength(Number(event.target.value))
              }
              className="w-full"
            />
          </ControlGroup>

          <ControlGroup label="Text color">
            <input
              type="color"
              value={textColor}
              onChange={(event) => setTextColor(event.target.value)}
              className="h-12 w-full cursor-pointer rounded-xl border border-white/10 bg-black/30 p-2"
            />
          </ControlGroup>

          <div className="mt-7 border-t border-white/10 pt-5">
            <p className="text-xs font-black uppercase tracking-[0.25em] text-white/35">
              Quick Actions
            </p>

            <button
              type="button"
              onClick={() => {
                setPrompt(
                  "Premium cinematic event flyer with fashionable guests, dramatic lighting, rich contrast and luxury editorial composition",
                );
                setActiveTool("ai");
              }}
              className="mt-4 w-full rounded-xl border border-violet-400/30 bg-violet-500/10 px-4 py-3 text-sm font-black text-violet-100"
            >
              Magic Design
            </button>

            <button
              type="button"
              onClick={() => {
                setHeadline(selectedEvent?.name || "Night Moves");
                setSubheadline(
                  selectedEvent?.description ||
                    "A premium event experience curated for the city.",
                );
                setCta("Get Tickets");
              }}
              className="mt-3 w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-black"
            >
              Import Event Details
            </button>

            <button
              type="button"
              className="mt-3 w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-black"
            >
              Duplicate Design
            </button>
          </div>
        </aside>
      </div>
    </main>
  );
}

function ToolPanel({
  title,
  children,
}: {
  title: string;
  children: React.ReactNode;
}) {
  return (
    <div>
      <h2 className="mb-4 text-lg font-black">{title}</h2>
      {children}
    </div>
  );
}

function ControlGroup({
  label,
  children,
}: {
  label: string;
  children: React.ReactNode;
}) {
  return (
    <div className="mt-5">
      <label className="mb-2 block text-xs font-bold text-white/45">
        {label}
      </label>
      {children}
    </div>
  );
}
