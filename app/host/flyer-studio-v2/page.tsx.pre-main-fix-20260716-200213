                      }
                      className={`flex h-9 w-9 items-center justify-center rounded-lg transition ${
                        selectedElement.textAlign === "right"
                          ? "bg-black text-white"
                          : "text-black/55 hover:bg-black/[0.06]"
                      }`}
                      title="Align right"
                    >
                      <AlignRight className="h-4 w-4" />
                    </button>

                    <div className="mx-1 h-6 w-px bg-black/10" />

                    <label
                      className="flex h-9 items-center gap-2 rounded-lg px-2 text-xs font-bold text-black/55 hover:bg-black/[0.04]"
                      title="Text color"
                    >
                      <Palette className="h-4 w-4" />
                      <input
                        type="color"
                        value={selectedElement.color ?? "#ffffff"}
                        onChange={(event) =>
                          updateElement(selectedElement.id, {
                            color: event.target.value,
                          })
                        }
                        className="h-5 w-5 cursor-pointer overflow-hidden rounded border-0 bg-transparent p-0"
                      />
                    </label>
                  </>
                )}

                {selectedElement.type === "image" && (
                  <>
                    <button
                      type="button"
                      onClick={() =>
                        updateElement(selectedElement.id, {
                          objectFit:
                            selectedElement.objectFit === "contain"
                              ? "cover"
                              : "contain",
                        })
                      }
                      className="h-9 rounded-lg px-3 text-xs font-black text-black/60 transition hover:bg-black/[0.06]"
                    >
                      {selectedElement.objectFit === "contain"
                        ? "Contain"
                        : "Fill"}
                    </button>

                    <label className="flex h-9 items-center gap-2 rounded-lg px-3 text-xs font-black text-black/60">
                      Opacity
                      <input
                        type="range"
                        min="0.1"
                        max="1"
                        step="0.05"
                        value={selectedElement.opacity ?? 1}
                        onChange={(event) =>
                          updateElement(selectedElement.id, {
                            opacity: Number(event.target.value),
                          })
                        }
                        className="w-24"
                      />
                    </label>
                  </>
                )}

                <div className="mx-1 h-6 w-px bg-black/10" />

                <button
                  type="button"
                  onClick={() =>
                    duplicateElement(selectedElement.id)
                  }
                  className="flex h-9 w-9 items-center justify-center rounded-lg text-black/55 transition hover:bg-black/[0.06] hover:text-black"
                  title="Duplicate"
                >
                  <Copy className="h-4 w-4" />
                </button>

                <button
                  type="button"
                  onClick={() =>
                    toggleElementLock(selectedElement.id)
                  }
                  className={`flex h-9 w-9 items-center justify-center rounded-lg transition ${
                    selectedElement.locked
                      ? "bg-amber-100 text-amber-700"
                      : "text-black/55 hover:bg-black/[0.06] hover:text-black"
                  }`}
                  title={
                    selectedElement.locked
                      ? "Unlock element"
                      : "Lock element"
                  }
                >
                  {selectedElement.locked ? (
                    <Lock className="h-4 w-4" />
                  ) : (
                    <Unlock className="h-4 w-4" />
                  )}
                </button>

                <button
                  type="button"
                  onClick={() =>
                    deleteElement(selectedElement.id)
                  }
                  className="flex h-9 w-9 items-center justify-center rounded-lg text-black/45 transition hover:bg-red-50 hover:text-red-600"
                  title="Delete"
                >
                  <Trash2 className="h-4 w-4" />
                </button>
              </div>
            </div>
          )}

          <div
            ref={workspaceRef}
            className="relative flex flex-1 items-start justify-center overflow-auto px-12 py-14"
            onPointerDown={(event) => {
              if (event.target === event.currentTarget) {
                setSelectedElementId(null);
                setEditingTextId(null);
              }
            }}
          >
            <div
              className="relative shrink-0"
              style={{
                width: CANVAS_WIDTH * canvasScale,
                height: CANVAS_HEIGHT * canvasScale,
              }}
            >
              <div
                ref={canvasRef}
                className="absolute left-0 top-0 origin-top-left overflow-hidden bg-[#111114] shadow-[0_30px_80px_rgba(0,0,0,0.28)]"
                style={{
                  width: CANVAS_WIDTH,
                  height: CANVAS_HEIGHT,
                  transform: `scale(${canvasScale})`,
                }}
                onPointerDown={(event) => {
                  if (event.target === event.currentTarget) {
                    setSelectedElementId(null);
                    setEditingTextId(null);
                  }
                }}
              >
                {generatedImage ? (
                  <img
                    src={generatedImage}
                    alt=""
                    draggable={false}
                    className="pointer-events-none absolute inset-0 h-full w-full object-cover"
                  />
                ) : (
                  <div className="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_30%_15%,rgba(124,58,237,.8),transparent_38%),radial-gradient(circle_at_82%_80%,rgba(249,115,22,.62),transparent_40%),linear-gradient(145deg,#111114_12%,#22103d_55%,#1b0b10)]" />
                )}

                <div className="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/5 via-transparent to-black/45" />

                {elements.map((element) => {
                  if (element.hidden) {
                    return null;
                  }

                  const isSelected =
                    selectedElementId === element.id;
                  const isEditing =
                    editingTextId === element.id;
                  const rotation =
                    element.rotation ?? 0;

                  return (
                    <div
                      key={element.id}
                      data-flyer-element="true"
                      className={`absolute select-none ${
                        element.locked
                          ? "cursor-default"
                          : isEditing
                            ? "cursor-text"
                            : "cursor-move"
                      }`}
                      style={{
                        left: element.x,
                        top: element.y,
                        width: element.width,
                        height: element.height,
                        zIndex: element.zIndex,
                        opacity: element.opacity ?? 1,
                        transform: `rotate(${rotation}deg)`,
                        transformOrigin: "center",
                      }}
                      onPointerDown={(event) =>
                        handleElementPointerDown(
                          event,
                          element,
                        )
                      }
                      onDoubleClick={(event) => {
                        event.stopPropagation();

                        if (
                          element.type === "text" &&
                          !element.locked
                        ) {
                          setSelectedElementId(element.id);
                          setEditingTextId(element.id);
                        }
                      }}
                    >
                      {element.type === "image" ? (
                        <img
                          src={element.src}
                          alt=""
                          draggable={false}
                          className="pointer-events-none h-full w-full"
                          style={{
                            objectFit:
                              element.objectFit ?? "cover",
                            borderRadius:
                              element.borderRadius ?? 0,
                          }}
                        />
                      ) : element.type === "text" ? (
                        isEditing ? (
                          <textarea
                            autoFocus
                            value={element.text}
                            onChange={(event) =>
                              updateElementWithoutHistory(
                                element.id,
                                {
                                  text: event.target.value,
                                },
                              )
                            }
                            onBlur={(event) => {
                              finishInlineTextEditing(
                                element.id,
                                event.currentTarget.value,
                              );
                            }}
                            onKeyDown={(event) => {
                              event.stopPropagation();

                              if (
                                event.key === "Escape"
                              ) {
                                event.preventDefault();
                                finishInlineTextEditing(
                                  element.id,
                                  event.currentTarget.value,
                                );
                              }

                              if (
                                event.key === "Enter" &&
                                (event.metaKey ||
                                  event.ctrlKey)
                              ) {
                                event.preventDefault();
                                finishInlineTextEditing(
                                  element.id,
                                  event.currentTarget.value,
                                );
                              }
                            }}
                            onPointerDown={(event) =>
                              event.stopPropagation()
                            }
                            className="h-full w-full resize-none overflow-hidden border-0 bg-transparent p-0 outline-none"
                            style={{
                              color:
                                element.color ?? "#ffffff",
                              fontFamily:
                                element.fontFamily ??
                                "Inter",
                              fontSize:
                                element.fontSize ?? 42,
                              fontWeight:
                                element.fontWeight ?? 700,
                              lineHeight:
                                element.lineHeight ?? 1.05,
                              letterSpacing:
                                element.letterSpacing ?? 0,
                              textAlign:
                                element.textAlign ?? "left",
                              textTransform:
                                element.textTransform ??
                                "none",
                            }}
                          />
                        ) : (
                          <div
                            className="pointer-events-none h-full w-full whitespace-pre-wrap break-words"
                            style={{
                              color:
                                element.color ?? "#ffffff",
                              fontFamily:
                                element.fontFamily ??
                                "Inter",
                              fontSize:
                                element.fontSize ?? 42,
                              fontWeight:
                                element.fontWeight ?? 700,
                              lineHeight:
                                element.lineHeight ?? 1.05,
                              letterSpacing:
                                element.letterSpacing ?? 0,
                              textAlign:
                                element.textAlign ?? "left",
                              textTransform:
                                element.textTransform ??
                                "none",
                              display: "flex",
                              alignItems:
                                element.verticalAlign ??
                                "flex-start",
                            }}
                          >
                            <span className="w-full">
                              {element.text}
                            </span>
                          </div>
                        )
                      ) : (
                        <div
                          className="h-full w-full"
                          style={{
                            background:
                              element.background ??
                              "#ffffff",
                            borderRadius:
                              element.borderRadius ?? 0,
                          }}
                        />
                      )}

                      {isSelected &&
                        !isEditing && (
                          <>
                            <div className="pointer-events-none absolute inset-0 border-2 border-violet-500" />

                            <div className="pointer-events-none absolute -top-8 left-0 rounded-md bg-violet-600 px-2 py-1 text-[10px] font-black text-white shadow-lg">
                              {Math.round(element.width)} ×{" "}
                              {Math.round(element.height)}
                            </div>

                            {!element.locked &&
                              resizeHandles.map(
                                (handle) => (
                                  <button
                                    key={handle}
                                    type="button"
                                    aria-label={`Resize ${handle}`}
                                    onPointerDown={(
                                      event,
                                    ) =>
                                      handleResizePointerDown(
                                        event,
                                        element,
                                        handle,
                                      )
                                    }
                                    className={`absolute z-20 h-3 w-3 rounded-full border-2 border-white bg-violet-600 shadow ${
                                      resizeHandleClasses[
                                        handle
                                      ]
                                    }`}
                                  />
                                ),
                              )}
                          </>
                        )}
                    </div>
                  );
                })}

                {snapGuides.vertical !== null && (
                  <div
                    className="pointer-events-none absolute bottom-0 top-0 z-[9999] w-px bg-cyan-400"
                    style={{
                      left: snapGuides.vertical,
                    }}
                  >
                    <div className="absolute left-1 top-2 rounded bg-cyan-500 px-1.5 py-0.5 text-[9px] font-black text-white">
                      SNAP
                    </div>
                  </div>
                )}

                {snapGuides.horizontal !== null && (
                  <div
                    className="pointer-events-none absolute left-0 right-0 z-[9999] h-px bg-cyan-400"
                    style={{
                      top: snapGuides.horizontal,
                    }}
                  >
                    <div className="absolute left-2 top-1 rounded bg-cyan-500 px-1.5 py-0.5 text-[9px] font-black text-white">
                      SNAP
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>

          <footer className="flex min-h-[52px] items-center justify-between border-t border-black/10 bg-white px-5 text-xs font-semibold text-black/45">
            <div className="flex items-center gap-3">
              <span>
                {elements.filter((element) => !element.hidden).length} visible
                elements
              </span>

              {selectedElement && (
                <>
                  <span className="h-1 w-1 rounded-full bg-black/20" />
                  <span>
                    X {Math.round(selectedElement.x)} · Y{" "}
                    {Math.round(selectedElement.y)}
                  </span>
                  <span className="h-1 w-1 rounded-full bg-black/20" />
                  <span>
                    W {Math.round(selectedElement.width)} · H{" "}
                    {Math.round(selectedElement.height)}
                  </span>
                </>
              )}
            </div>

            <div className="flex items-center gap-2">
              <button
                type="button"
                onClick={() =>
                  setCanvasScale((current) =>
                    Math.max(0.25, current - 0.05),
                  )
                }
                className="flex h-8 w-8 items-center justify-center rounded-lg text-black/50 transition hover:bg-black/[0.05] hover:text-black"
                aria-label="Zoom out"
              >
                <Minus className="h-4 w-4" />
              </button>

              <button
                type="button"
                onClick={() => setCanvasScale(0.58)}
                className="min-w-[52px] rounded-lg px-2 py-1.5 text-center font-black text-black/55 transition hover:bg-black/[0.05]"
              >
                {Math.round(canvasScale * 100)}%
              </button>

              <button
                type="button"
                onClick={() =>
                  setCanvasScale((current) =>
                    Math.min(1.2, current + 0.05),
                  )
                }
                className="flex h-8 w-8 items-center justify-center rounded-lg text-black/50 transition hover:bg-black/[0.05] hover:text-black"
                aria-label="Zoom in"
              >
                <Plus className="h-4 w-4" />
              </button>
            </div>
          </footer>
        </main>
      </div>
    </div>
  );
}
