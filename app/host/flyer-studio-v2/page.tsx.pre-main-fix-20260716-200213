        event.preventDefault();

        commitElements((current) =>
          current.filter(
            (element) => element.id !== selectedElementId,
          ),
        );

        setSelectedElementId("");
      }
    }

    window.addEventListener("keydown", handleKeyDown);

    return () => {
      window.removeEventListener("keydown", handleKeyDown);
